# -- Required API Keys --
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# -- Optional API Keys --
PEXELS_API_KEY=your_pexels_api_key_here

# -- YouTube Credentials --
YOUTUBE_CLIENT_SECRETS=client_secret.json

# -- ElevenLabs Config --
ELEVENLABS_VOICE_ID=TxGEqnHWrfWFTfGW9XjX

# -- ComfyUI (RunPod remote GPU) --
# Find in your RunPod pod → Connect → HTTP ports → 8188
# Example: https://abc123xyz-8188.proxy.runpod.net
COMFYUI_URL=https://YOUR_POD_ID-8188.proxy.runpod.net

# -- Optional ComfyUI Tuning (defaults are shown) --
# COMFYUI_WORKFLOW=comfyui_workflow.json
# COMFYUI_PROMPT_NODE=340:319
# COMFYUI_TIMEOUT=600
# COMFYUI_VIDEO_FRAMES=81
# COMFYUI_VIDEO_FPS=16
# COMFYUI_VIDEO_STEPS=20
