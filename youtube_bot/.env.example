# -- RunPod Automation --
# Get from: https://www.runpod.io/console/settings/api-keys
RUNPOD_API_KEY=your_runpod_api_key_here

# -- Required API Keys --
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# -- Optional API Keys --
PEXELS_API_KEY=your_pexels_api_key_here

# -- YouTube Credentials --
YOUTUBE_CLIENT_SECRETS=client_secret.json

# -- ElevenLabs Config --
ELEVENLABS_VOICE_ID=TxGEqnHWrfWFTfGW9XjX

# -- ComfyUI (RunPod remote GPU) --
# NOTE: If using runpod_launch.py, this URL is AUTOMATICALLY managed and updated!
# You do not need to set it manually.
COMFYUI_URL=

# -- Optional ComfyUI Tuning (defaults are shown) --
# COMFYUI_WORKFLOW=47d245c34a7d.json
# COMFYUI_PROMPT_NODE=267:266
# COMFYUI_TIMEOUT=600
# COMFYUI_VIDEO_FRAMES=81
# COMFYUI_VIDEO_FPS=16
# COMFYUI_VIDEO_STEPS=20
